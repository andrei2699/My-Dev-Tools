---
import NavBar from "../components/NavBar.astro";
import Toolbar from "../components/Toolbar.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8">
		<link rel="icon" type="image/svg+xml" href="/My-Dev-Tools/favicon.svg">
		<link rel="icon" href="/My-Dev-Tools/favicon.ico">
		<meta name="viewport" content="width=device-width">
		<meta name="generator" content={Astro.generator}>
		<title>Dev Tools</title>
	</head>
	<body>
		<Toolbar />
		<div style="display: flex; gap: 1rem; width: 100%; height: 100%">
			<NavBar />
			<div style="height: 100%; flex: 1">
				<slot />
			</div>
		</div>
	</body>
</html>

<style is:global>
:root {
	/* Colors */
	--color-primary: #4f7cff;
	--color-primary-hover: #3f6ee6;

	--color-bg: #f8f9fb;
	--color-bg-hover: #eef1f6;

	--color-text: #1f2937;
	--color-text-hover: #111827;

	/* Typography */
	--font-sans: system-ui, sans-serif;
	--font-mono: ui-monospace, monospace;
}

@media (prefers-color-scheme: dark) {
	:root {
		--color-primary: #7c9cff;
		--color-primary-hover: #91aaff;

		--color-bg: #101216;
		--color-bg-hover: #1a1e26;

		--color-text: #e5e7eb;
		--color-text-hover: #ffffff;
	}
}

[data-theme="dark"] {
	--color-primary: #7c9cff;
	--color-primary-hover: #91aaff;

	--color-bg: #101216;
	--color-bg-hover: #1a1e26;

	--color-text: #e5e7eb;
	--color-text-hover: #ffffff;
}

body {
	margin: 0;
	background: var(--color-bg);
	color: var(--color-text);
	font-family: var(--font-sans), serif;
}

.spacer {
	flex: 1;
}

button {
	padding: 0.5rem;
	border-radius: 10%;
}
</style>
