---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
	<h2>Base64 Decode</h2>

	<div class="container">
		<label for="input-text" aria-labelledby="input-text" class="text-box-label">
			<textarea
				id="input-text"
				placeholder="Type (or paste) here..."
				spellcheck="false"
				class="text-box"
			/>
		</label>

		<br>

		<label
			for="output-text"
			aria-labelledby="output-text"
			class="text-box-label"
		>
			<textarea
				id="output-text"
				placeholder="Results is here...."
				spellcheck="false"
				class="text-box"
			/>
		</label>

		<br>
	</div>
</BaseLayout>

<script>
import type { InputEvent } from "../types/EventTypes.ts";

const inputText = document.querySelector<HTMLTextAreaElement>("#input-text")!;
const outputText = document.querySelector<HTMLTextAreaElement>("#output-text")!;

inputText.addEventListener("input", (e) => {
	const target = e.target as unknown as InputEvent;

	outputText.value = atob(target.value);
});
</script>

<style>
.container {
	display: flex;
	flex-direction: column;
	width: 100%;
}

.text-box-label {
	display: flex;
	justify-content: center;
	width: 100%;
}

.text-box {
	min-width: 90%;
	min-height: 16rem;
}
</style>
